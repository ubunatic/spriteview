[Desktop Entry]
Name=Sprite View
Comment=Preview and export sprites and sprite sheet sequences
Exec=.local/bin/spriteview %F
Icon=com.ubunatic.spriteview
Terminal=false
Type=Application
MimeType=image/png;image/gif;image/bmp;image/jpeg;image/webp;
Categories=Graphics;Viewer;GTK;
StartupNotify=true
StartupWMClass=com.ubunatic.spriteview
Actions=settings;about;

[Desktop Action settings]
Name=Settings
Exec=.local/bin/spriteview --settings

[Desktop Action about]
Name=About
Exec=.local/bin/spriteview --about
